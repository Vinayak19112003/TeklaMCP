{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Element Schema",
  "type": "object",
  "required": ["id", "type", "profile", "material", "start_point", "end_point"],
  "properties": {
    "id": {"type": "string"},
    "type": {
      "type": "string",
      "enum": ["column", "beam", "rafter", "purlin", "brace"]
    },
    "profile": {
      "type": "object",
      "properties": {
        "profile_string": {"type": "string"}
      }
    },
    "material": {
      "type": "object",
      "properties": {
        "material_string": {"type": "string"},
        "material_type": {"type": "string"}
      }
    },
    "start_point": {
      "type": "object",
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "end_point": {
      "type": "object"
    }
  }
}
