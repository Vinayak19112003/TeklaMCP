{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Connection Schema",
  "type": "object",
  "required": ["id", "type", "primary_element"],
  "properties": {
    "id": {"type": "string"},
    "type": {
      "type": "string",
      "enum": ["base_plate", "moment", "simple_shear", "splice"]
    },
    "primary_element": {"type": "string"},
    "secondary_elements": {
      "type": "array",
      "items": {"type": "string"}
    },
    "bolts": {"type": "object"},
    "welds": {"type": "array"}
  }
}
