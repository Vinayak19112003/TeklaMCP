# AI API Keys
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Cloud OCR Services
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
GOOGLE_VISION_KEY=

# Optional: Vector Database (for RAG)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=tekla-api-docs

# Application Settings
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# Processing Settings
AUTO_EXECUTE=false  # Automatically execute code in Tekla
PARALLEL_PROCESSING=true
MAX_WORKERS=4

# Code Generation
CODE_TEMPLATE_DIR=./templates
OUTPUT_DIR=./output

# Tekla Settings
TEKLA_VERSION=2023
TEKLA_API_PATH=C:\Program Files\Tekla Structures\2023.0\nt\bin\plugins

# Development
DEBUG=false
SAVE_INTERMEDIATE_RESULTS=true
